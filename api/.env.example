# ---------------------------------------------------------------------------
# Sekar Construction API — environment template
# Copy to .env and fill values. NEVER commit .env.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# HTTP port
PORT=3001

# Database — MariaDB / MySQL only (mysql2). SQLite and PostgreSQL are not supported.
# Prefer discrete DB_* when the password contains special characters (@, :, /, #, etc.).
# If using DATABASE_URL alone, percent-encode the password (e.g. @ → %40).
# Example shape (encode @ in password as %40 when using DATABASE_URL):
# DATABASE_URL=mysql://USER:PASS%40WORD@sekarconstructions.com:3306/Sekarcons
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/Sekarcons
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_NAME=Sekarcons
# Optional local Docker MariaDB (api/docker-compose.yml → host 3306):
# DATABASE_URL=mysql://gan131:change-me-local-only@127.0.0.1:3306/Sekarcons
# DB_HOST=127.0.0.1

# Session signing / cookie secret (min 32 random chars in production)
# Used for: CSRF token HMAC, TOTP secret encryption (AES-256-GCM), signed login challenges.
# **WARNING: Rotating SESSION_SECRET makes all stored totp_secret values undecryptable and permanently locks out every admin with 2FA enabled. Admins must disable 2FA before rotating SESSION_SECRET and re-enroll after.**
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Cookie settings
# Local same-origin / Live Server: COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Production HTTPS: COOKIE_SECURE=true
# Cross-origin admin (e.g. https://….github.io → API on Render): COOKIE_SECURE=true and COOKIE_SAMESITE=none
# Note: admin-auth.js primarily uses Authorization Bearer (sessionStorage); cookies are a fallback.
# Defaults to lax in config.js when unset. Set none only for cross-origin admin cookies.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Cookie max-age in hours (default 8). Absolute server-side session lifetime.
# Frontend also enforces a 15-minute inactivity timeout (see README — intentional layered design).
SESSION_HOURS=8

# CORS allowlist — comma-separated origins (static site + admin + jobs subdomain)
# Serve pages via Live Server http://127.0.0.1:5500 (or similar http:// origin).
# Never use file:// for authenticated testing — browsers send Origin: null, which is rejected.
# Do not include literal "null" or "*" in this list.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080
# Production example (custom domain + jobs host):
# CORS_ORIGINS=https://www.sekarconstructions.com,https://sekarconstructions.com,https://jobs.sekarconstructions.com
# GitHub Pages marketing + remote API (include project Pages origin; no trailing slash on origin):
# CORS_ORIGINS=https://nplmedmarketing-collab.github.io
# Cross-origin Pages → API: see api/DEPLOY-GITHUB-PAGES.md and set REMOTE_API_BASE in config.site.js

# Public Sekar careers host (listings + inline apply). Not an SMTP address — web origin only.
# JOBS_SITE_URL=https://jobs.sekarconstructions.com

# Auth lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# TOTP lockout (separate from password lockout)
# MAX_TOTP_FAILED_ATTEMPTS=10
# TOTP_LOCKOUT_MINUTES=15
# SEED_ADMIN_USERNAME=superadmin
# SEED_ADMIN_PASSWORD=GenerateAStrongUniquePassword!
# If SEED_ADMIN_PASSWORD is unset, seed uses a local-only default (see README) — never leave that for production.

# Optional MariaDB/MySQL SSL CA (PEM path or inline). When set, knex uses rejectUnauthorized: true + ca.
# MYSQL_SSL_CA=/path/to/provider-ca.pem
# Or force SSL in non-prod: DATABASE_SSL=true
# Production enables SSL by default unless DATABASE_SSL=false.

# HRPops careers integration (careers.html — server-side proxy)
# Job listings are public; inline apply submits multipart form data via the proxy.
HRPOPS_API_KEY=
HRPOPS_COMPANY_ID=215
# Optional overrides (defaults shown):
# HRPOPS_API_BASE=https://api.hrpops.com
# HRPOPS_AUTH_MODE=bearer
# Inline apply is the default — Apply Now opens a modal on careers.html / jobs.sekarconstructions.com (no hrpops.com account).
# Leave HRPOPS_APPLY_URL_TEMPLATE unset to keep inline apply. Set only to redirect per-job Apply to hosted HRPops:
# HRPOPS_APPLY_URL_TEMPLATE=https://www.hrpops.com/careers/apply/{companyId}/{jobPostId}
# Optional HRPops-hosted portal fallback (general listing link — NOT jobs.sekarconstructions.com).
# Our public careers UI is Sekar-owned at JOBS_SITE_URL; keep this on hrpops.com if used at all:
# HRPOPS_CANDIDATE_PORTAL_URL=https://www.hrpops.com/careers/{companyId}
# Live apply in smoke-test.js (creates a real HRPops applicant). Default off.
# When enabled, uses sekar.test+{unix}@mailinator.com / "Sekar Test Applicant" — never real emails.
# HRPOPS_SMOKE_APPLY=1

# SMTP Email Dispatch (contact inquiries + careers thank-you + HR application alerts)
# REQUIRED to send mail: SMTP_HOST, SMTP_USER, SMTP_PASS (leave SMTP_PASS empty until you have the real password)
# Optional: SMTP_PORT (default 587), SMTP_SECURE (true for port 465)
# NOTIFICATION_EMAIL receives inquiry alerts and new careers-application HR alerts.
# From address = SMTP_USER (emailService). Use careers@ for From + alerts; switch NOTIFICATION_EMAIL to ho@ if preferred.
# If SMTP unset, inquiries still save and careers apply still succeeds; emails are skipped with a warning log.
NOTIFICATION_EMAIL=careers@sekarconstructions.com
# Plesk/domain mail is often mail.sekarconstructions.com or smtp.sekarconstructions.com — confirm in Plesk Mail Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=careers@sekarconstructions.com
SMTP_PASS=
SMTP_SECURE=false
# Examples once you have credentials:
# SMTP_HOST=mail.sekarconstructions.com
# SMTP_USER=careers@sekarconstructions.com
# SMTP_PASS=your-mailbox-password

