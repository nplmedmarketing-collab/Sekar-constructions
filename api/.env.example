# ---------------------------------------------------------------------------
# Sekar Construction API — environment template
# Copy to .env and fill values. NEVER commit .env.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# HTTP port
PORT=3001

# Database
# Verified local path when Docker is unavailable (this workspace default):
DATABASE_URL=file:./dev.sqlite
# Optional local Docker Postgres (api/docker-compose.yml maps host 5433 → container 5432):
# LOCAL-DEV credentials only — never use these in production.
# DATABASE_URL=postgres://sekar_local:sekar_local_dev_only@127.0.0.1:5433/sekar_cms
# Production (PostgreSQL) — use your own strong password / managed DB (provider port often 5432):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/sekar_cms

# Session signing / cookie secret (min 32 random chars in production)
# Used for: CSRF token HMAC, TOTP secret encryption (AES-256-GCM), signed login challenges.
# **WARNING: Rotating SESSION_SECRET makes all stored totp_secret values undecryptable and permanently locks out every admin with 2FA enabled. Admins must disable 2FA before rotating SESSION_SECRET and re-enroll after.**
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Cookie settings
# In production behind HTTPS set COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Cookie max-age in hours (default 8). Absolute server-side session lifetime.
# Frontend also enforces a 15-minute inactivity timeout (see README — intentional layered design).
SESSION_HOURS=8

# CORS allowlist — comma-separated origins (static site + admin)
# Serve pages via Live Server http://127.0.0.1:5500 (or similar http:// origin).
# Never use file:// for authenticated testing — browsers send Origin: null, which is rejected.
# Do not include literal "null" or "*" in this list.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080
# Production example:
# CORS_ORIGINS=https://www.sekarconstructions.com,https://sekarconstructions.com

# Auth lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# TOTP lockout (separate from password lockout)
# MAX_TOTP_FAILED_ATTEMPTS=10
# TOTP_LOCKOUT_MINUTES=15
# SEED_ADMIN_USERNAME=superadmin
# SEED_ADMIN_PASSWORD=GenerateAStrongUniquePassword!
# If SEED_ADMIN_PASSWORD is unset, seed uses a local-only default (see README) — never leave that for production.

# Optional Postgres SSL CA (PEM path or inline). When set, knex uses rejectUnauthorized: true + ca.
# PG_SSL_CA=/path/to/provider-ca.pem
# Or force SSL in non-prod: DATABASE_SSL=true

# SMTP Email Dispatch for Contact Form Inquiries
NOTIFICATION_EMAIL=ho@sekarconstructions.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ho@sekarconstructions.com
# SMTP_PASS=your-app-password

